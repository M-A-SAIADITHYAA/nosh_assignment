{
  "name": "nosh-dish-backend",
  "version": "1.0.0",
  "description": "Backend API for Nosh Dish Dashboard with OCC and SQLite persistence",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "seed": "tsx seed/seed.ts",
    "seed:fixtures": "tsx seed/seed.ts --with-fixtures",
    "seed:reset": "tsx seed/seed.ts --force",
    "test": "node --import tsx --test test/api.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
